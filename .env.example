# Copy to .env and adjust. Never commit a real .env.

# The web app under test
WEB_BASE_URL=http://localhost:3000

# The API behind it. Used to arrange state without driving the browser,
# and to assert on responses the page receives.
API_BASE_URL=http://localhost:3000

# Seeded READ-ONLY account for the successful-login journey.
# Never point a state-changing test (lockout, password change) at this account.
BUYER_USERNAME=buyer@example.com
BUYER_PASSWORD=Password123!

# Paths in the web app. Defaults match the demo app.
# Live Books Library (Docker nginx): /signin, /, /orders
# LOGIN_PATH=/login
# HOME_PATH=/home
# PROTECTED_PATH=/orders

# local | ci | staging | prod
TEST_ENV=local
